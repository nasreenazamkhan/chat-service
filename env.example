# ─── Copy this file to .env and fill in your values ──────────────────────────
# cp .env.example .env

# ─── API Security ─────────────────────────────────────────────────────────────
API_KEY=my-local-dev-api-key-12345

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=chat_db
DB_USERNAME=root
DB_PASSWORD=secret

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN_1=http://localhost:3000
CORS_ORIGIN_2=http://localhost:8080
